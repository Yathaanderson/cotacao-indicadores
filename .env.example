# Copie este arquivo para .env e preencha. Não versione o .env.

# Domínio público (o DNS precisa apontar para o IP da VPS)
APP_DOMAIN=cotacao.seudominio.com.br

# Banco MySQL (usado pela stack do docker-compose)
MYSQL_PASSWORD=troque-por-uma-senha-forte
MYSQL_ROOT_PASSWORD=troque-por-outra-senha-forte

# Sessão de login. Gere com: openssl rand -hex 48
JWT_SECRET=

# Responsável (administrador). Criado na primeira inicialização.
ADMIN_EMAIL=responsavel@seudominio.com.br
ADMIN_PASSWORD=troque-por-uma-senha-de-pelo-menos-8-caracteres
ADMIN_NAME=Responsável

# Alertas por e-mail ao responsável (SMTP próprio, por exemplo o do provedor de e-mail)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Opcional: se vazio, usa ADMIN_EMAIL
NOTIFY_EMAIL=

# Automação: "simulado" (padrão, não toca no PowerCRM) ou "powercrm" (Playwright, exige acesso e seletores)
AUTOMATION_DRIVER=simulado
